# Pinecone API configuration (required for vector similarity search)
PINECONE_API_KEY=your-pinecone-api-key

# OpenAI API Key (currently used solely for Pinecone 3072-dim text-embedding-3-large queries)
OPENAI_API_KEY=your-openai-api-key

# Ollama Local LLM Configuration (Free, local text generation)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
